---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: siwins-jobs-data-sync
spec:
  schedule: "0 0 * * *"
  concurrencyPolicy: Allow
  failedJobsHistoryLimit: 5
  successfulJobsHistoryLimit: 5
  jobTemplate:
    metadata:
      labels:
        cronjob: siwins-jobs-data-sync
    spec:
      backoffLimit: 3
      activeDeadlineSeconds: 900 # Fail job if it takes more than 15 mins
      template:
        metadata:
          labels:
            cronjob: siwins-jobs-data-sync
        spec:
          containers:
          - name: siwins-jobs-data-sync
            image: eu.gcr.io/akvo-lumen/siwins/backend:${CI_COMMIT}
            command: ["/bin/bash", "-c"]
            args:
              - echo Running Data Sync;
                ./sync.sh;
            env:
              - name: SIWINS_INSTANCE
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: siwins-instance
              - name: DATABASE_URL
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: database-url
              - name: AUTH0_PWD
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: auth0-pwd
              - name: AUTH0_USER
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: auth0-user
              - name: AUTH0_CLIENT
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: auth0-client
              - name: EMAIL_HOST
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: email-host
              - name: EMAIL_HOST_USER
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: email-host-user
              - name: EMAIL_HOST_PASSWORD
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: email-host-password
              - name: EMAIL_PORT
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: email-port
                    optional: true
              - name: EMAIL_USE_TLS
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: email-use-tls
                    optional: true
              - name: EMAIL_USE_SSL
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: email-use-ssl
                    optional: true
              - name: EMAIL_FROM
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: email-from
                    optional: true
              - name: NOTIFICATION_RECIPIENTS
                valueFrom:
                  secretKeyRef:
                    name: siwins
                    key: notification-recipients
          restartPolicy: Never